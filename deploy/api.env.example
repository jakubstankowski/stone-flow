# Wzór zmiennych środowiskowych API. Wartości ustawia się w konfiguracji wdrożenia
# albo lokalnie przez dotnet user-secrets. Nie zapisuj prawdziwych wartości w repozytorium.
ConnectionStrings__StoneFlow=Server=<host>,1433;Database=StoneFlow;User Id=<uzytkownik>;Password=<haslo>;TrustServerCertificate=True
StoneFlow__LaunchDate=<yyyy-MM-dd>
StoneFlow__Owner__Email=<owner@example.com>
StoneFlow__App__BaseUrl=<https://adres-aplikacji>
StoneFlow__Email__Mode=Smtp
StoneFlow__Email__Smtp__Host=<serwer-smtp>
StoneFlow__Email__Smtp__Port=587
StoneFlow__Email__Smtp__UseStartTls=true
StoneFlow__Email__Smtp__UserName=<uzytkownik-smtp>
StoneFlow__Email__Smtp__Password=<haslo-smtp>
StoneFlow__Email__Smtp__FromAddress=<noreply@example.com>
# Webhooki WooCommerce (SF-12): brak wartości = integracja wyłączona; co najmniej 16 znaków.
StoneFlow__WooCommerce__WebhookSecret=<sekret-webhooka>
