<?xml version="1.0" encoding="utf-8"?>
<!--
  Konfiguracja IIS/ANCM dla hostingu: paczka framework-dependent uruchamiana przez dotnet, in-process.
  Logi stdout (JSON z korelacją, bez sekretów) trafiają do .\logs\ na serwerze; pliki nie są
  rotowane — czyszczenie opisuje docs/wdrozenia.md. Sekrety i konfiguracja środowiska są w
  appsettings.Production.json na serwerze, nie w tym pliku.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\StoneFlow.Api.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
