{
  "name": "stone-flow",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint && npm run lint:colors",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "e2e": "playwright test",
    "lint:colors": "node scripts/check-color-literals.mjs",
    "test:scripts": "node --test \"scripts/*.test.mjs\""
  },
  "private": true,
  "packageManager": "npm@11.6.1",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "chart.js": "4.6.1",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "angular-eslint": "22.6.0",
    "daisyui": "5.7.50",
    "eslint": "10.14.0",
    "jsdom": "30.1.3",
    "playwright-core": "1.64.1",
    "postcss": "8.5.32",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.1.0"
  }
}
